#ifndef SECRETS_H
#define SECRETS_H

// Credenziali WiFi (usate solo per la sincronizzazione NTP).
// Copia questo file in src/secrets.h e inserisci i tuoi valori:
//     cp src/secrets.h.example src/secrets.h
// src/secrets.h è in .gitignore: non finisce mai nel repository.
const char* WIFI_SSID = "il-tuo-ssid";
const char* WIFI_PASSWORD = "la-tua-password";

// IRK (Identity Resolving Key) del telefono: riconosce i suoi indirizzi BLE
// casuali. Sono i 16 byte del base64 "Remote IRK" del pairing su macOS
// (echo '<base64>' | base64 -d | xxd -i); il firmware prova anche l'ordine
// inverso. Tutti a zero = controllo presenza spento.
const uint8_t PHONE_IRK[16] = {0};

#endif // SECRETS_H
